#!/bin/bash

set -e

echo "Running post-install script…"

echo "Creating user and group"

useradd -r -s /usr/sbin/nologin sc3

echo "Adding to plugdev and gpio groups"
usermod -aG gpio,plugdev sc3

echo "Adding mounts path"
mkdir -p /mnt/sc3_mounts
chown sc3:sc3 /mnt/sc3_mounts
chmod 775 /mnt/sc3_mounts

echo "Reloading udev rules"
udevadm control --reload

echo "Enabling and running systemd service"

systemctl daemon-reload
systemctl enable --now sc3-camera-connector

echo "Done"